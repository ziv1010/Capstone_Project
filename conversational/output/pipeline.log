import pandas as pd
import numpy as np

# Reshape to long format and create lag features
file_path = DATA_DIR / 'All-India-Estimates-of-Area,-Production-&-Yield-of-Food-Grains.csv'
df = pd.read_csv(file_path, usecols=[
    'Crop', 'Season',
    'Area-2020-21', 'Area-2021-22', 'Area-2022-23', 'Area-2023-24', 'Area-2024-25',
    'Production-2020-21', 'Production-2021-22', 'Production-2022-23', 'Production-2023-24', 'Production-2024-25',
    'Yield-2020-21', 'Yield-2021-22', 'Yield-2022-23', 'Yield-2023-24', 'Yield-2024-25'
])
df = df[df['Season'] != 'Total']

# Reshape to long format
df = df.melt(id_vars=['Crop', 'Season'], var_name='period', value_name='value')
df[['metric', 'year']] = df['period'].str.extract(r'(\D+)(\d+)')
df = df.pivot_table(index=['Crop', 'Season', 'year'], columns='metric', values='value', aggfunc='first').reset_index()
df['Year'] = df['year'].str[:4].astype(int)

df = df.sort_values(['Crop', 'Season', 'Year'])
df['lag_1'] = df.groupby(['Crop', 'Season'])['Production'].shift(1)
df['lag_2'] = df.groupby(['Crop', 'Season'])['Production'].shift(2)
df['rolling_mean_3'] = df.groupby(['Crop', 'Season'])['Production'].rolling(3).mean().reset_index(level=[0,1], drop=True)

# Handle NaNs from lag operations
df = df.fillna(0)  # Replace NaNs with 0 for missing lag values

print(f"Shape: {df.shape}")
print(f"Nulls: {df.isnull().sum().sum()}")
