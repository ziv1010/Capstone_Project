df1 = pd.read_csv(DATA_DIR / 'All-India-Estimates-of-Area,-Production-&-Yield-of-Food-Grains.csv',
                 usecols=['Crop', 'Season', 'Area-2020-21', 'Area-2021-22', 'Area-2022-23', 'Area-2023-24', 'Area-2024-25',
                          'Production-2020-21', 'Production-2021-22', 'Production-2022-23', 'Production-2023-24', 'Production-2024-25',
                          'Yield-2020-21', 'Yield-2021-22', 'Yield-2022-23', 'Yield-2023-24', 'Yield-2024-25'])

# Apply Season filter and crop standardization
df1 = df1[df1['Season'] == 'Total']
df1['Crop'] = df1['Crop'].str.strip().str.lower()

df2 = pd.read_csv(DATA_DIR / 'Wholesale-Mandi_Price-from-2012-to-2025 in(RS_qntls) (1).csv',
                 usecols=['Crop', 'January-2025'])
df2['Crop'] = df2['Crop'].str.strip().str.lower()

# Perform inner join
merged_df = df1.merge(df2, on='Crop', how='inner')

# Reshape to long format with cleaned year values
production_melt = merged_df.melt(id_vars=['Crop', 'Season', 'January-2025'],
                        value_vars=[col for col in merged_df.columns if 'Production' in col],
                        var_name='year',
                        value_name='Production')
production_melt['year'] = production_melt['year'].str.replace('Production-', '')

area_melt = merged_df.melt(id_vars=['Crop', 'Season', 'January-2025'],
                     value_vars=[col for col in merged_df.columns if 'Area' in col],
                     var_name='year',
                     value_name='Area')
area_melt['year'] = area_melt['year'].str.replace('Area-', '')

yield_melt = merged_df.melt(id_vars=['Crop', 'Season', 'January-2025'],
                      value_vars=[col for col in merged_df.columns if 'Yield' in col],
                      var_name='year',
                      value_name='Yield')
yield_melt['year'] = yield_melt['year'].str.replace('Yield-', '')

# Merge melted data
long_df = production_melt.merge(area_melt, on=['Crop', 'Season', 'year', 'January-2025'], how='inner')
long_df = long_df.merge(yield_melt, on=['Crop', 'Season', 'year', 'January-2025'], how='inner')

# Final cleanup - remove Season drop attempt
columns_to_keep = ['Crop', 'year', 'Production', 'Area', 'Yield', 'January-2025']
final_df = long_df[columns_to_keep]

print(f"Final shape: {final_df.shape}")
print(f"Nulls in final data: {final_df.isnull().sum().sum()}")
