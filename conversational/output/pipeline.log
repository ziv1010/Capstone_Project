        "implementation_code": "def predict_simple_average(train_df, test_df, target_col, date_col, **params):\n    import pandas as pd\n    import numpy as np\n    last_two = train_df[target_col].tail(2)\n    prediction = last_two.mean()\n    return pd.DataFrame({\"predicted\": [prediction] * len(test_df)})",
