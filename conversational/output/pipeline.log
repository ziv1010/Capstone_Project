import pandas as pd

# Full pipeline
# Load data
df = pd.read_csv(DATA_DIR / 'All-India-Estimates-of-Area,-Production-&-Yield-of-Food-Grains.csv', 
                 usecols=['Crop', 'Season', 'Area-2020-21', 'Area-2021-22', 'Area-2022-23', 'Area-2023-24', 'Area-2024-25',
                          'Production-2020-21', 'Production-2021-22', 'Production-2022-23', 'Production-2023-24', 'Production-2024-25',
                          'Yield-2020-21', 'Yield-2021-22', 'Yield-2022-23', 'Yield-2023-24', 'Yield-2024-25'])

# Initial filters
df = df[df['Season'] != 'Total']

# Reshape to long format
df = df.melt(id_vars=['Crop', 'Season'], var_name='variable', value_name='value')
df[['metric', 'year']] = df['variable'].str.split('-', expand=True).iloc[:, [0, 1]]
df = df.pivot(index=['Crop', 'Season', 'year'], columns='metric', values='value').reset_index()
df = df.dropna(subset=['Production'])

# Create lag features
df['Area_lag1'] = df.groupby(['Crop', 'Season'])['Area'].shift(1)
df['Yield_lag1'] = df.groupby(['Crop', 'Season'])['Yield'].shift(1)
df['Production_lag1'] = df.groupby(['Crop', 'Season'])['Production'].shift(1)

# Drop remaining NaNs from lag features (first year in each group)
df = df.dropna()

print(f"Shape: {df.shape}")
print(f"Nulls: {df.isnull().sum().sum()}")
