@startuml AI_Pipeline_LangGraph_Style

title AI Pipeline - LangGraph Architecture
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f1f5f9
skinparam ArrowColor #94a3b8
skinparam stateBorderColor #475569
skinparam stateBackgroundColor #1e293b

' ===== MAIN PIPELINE GRAPH =====
state "Pipeline StateGraph" as Pipeline {
    
    state "START" as Start <<start>>
    
    state "stage1_node" as S1 #6366f1 {
        S1 : profile_dataset()
        S1 : save_dataset_summary()
    }
    
    state "stage2_node" as S2 #6366f1 {
        S2 : explore_data_relationships()
        S2 : record_thought()
        S2 : save_task_proposals()
    }
    
    state "stage3_node" as S3 #6366f1 {
        S3 : read_dataset_summary()
        S3 : save_stage3_plan()
    }
    
    state "stage3b_node" as S3B #6366f1 {
        S3B : load_data_for_preparation()
        S3B : execute_prep_code()
        S3B : save_prepared_data()
    }
    
    state "stage3c_node" as S3C #f59e0b {
        S3C : load_data_for_feature_engineering()
        S3C : execute_feature_code()
        S3C : validate_features()
        S3C : save_enhanced_data()
        S3C : <<OPTIONAL>>
    }
    
    state "stage3_5a_node" as S35A #6366f1 {
        S35A : read_stage3_plan()
        S35A : read_prepared_data_columns()
        S35A : save_method_proposal()
    }
    
    state "stage3_5b_node" as S35B #6366f1 {
        S35B : load_prepared_data()
        S35B : execute_benchmark_code()
        S35B : save_checkpoint()
        S35B : select_best_method()
        S35B : save_tester_output()
    }
    
    state "stage4_node" as S4 #6366f1 {
        S4 : load_execution_context()
        S4 : execute_code()
        S4 : save_execution_result()
    }
    
    state "stage5_node" as S5 #6366f1 {
        S5 : load_stage4_results()
        S5 : execute_visualization_code()
        S5 : save_visualization_report()
    }
    
    state "stage6_node" as S6 #6366f1 {
        S6 : load_all_stage_outputs()
        S6 : generate_report_section()
        S6 : save_final_report()
    }
    
    state "END" as End <<end>>
    
    ' Main flow
    Start --> S1 : run_full_pipeline()
    S1 --> S2 : summaries saved
    S2 --> S3 : task selected
    S3 --> S3B : plan saved
    S3B --> S35A : data prepared
    S3B --> S3C : [optional]\nrun_feature_engineering()
    S3C --> S35A : features added
    S35A --> S35B : methods proposed
    S35B --> S4 : best method selected
    S4 --> S5 : predictions made
    S5 --> S6 : visualizations done
    S6 --> End : report saved
}

' ===== GUARDRAILS GRAPH =====
state "Guardrails StateGraph" as Guardrails #10b981 {
    
    state "start" as G_Start <<start>>
    
    state "agent_node" as G_Agent {
        G_Agent : LLM reasoning
    }
    
    state "tools_node" as G_Tools {
        G_Tools : compute_correlation_metrics()
        G_Tools : compute_propensity_scores()
        G_Tools : compute_ipw_validation()
        G_Tools : compute_residual_analysis()
        G_Tools : save_guardrails_report()
    }
    
    state "end" as G_End <<end>>
    
    G_Start --> G_Agent
    G_Agent --> G_Tools : has_tool_calls
    G_Tools --> G_Agent : tool results
    G_Agent --> G_End : report_saved
}

' ===== FEEDBACK LOOP GRAPH =====
state "Feedback StateGraph" as Feedback #f59e0b {
    
    state "start" as F_Start <<start>>
    
    state "agent_node" as F_Agent {
        F_Agent : LLM reasoning
    }
    
    state "tools_node" as F_Tools {
        F_Tools : load_guardrails_for_feedback()
        F_Tools : execute_remediation_code()
        F_Tools : update_method_constraints()
        F_Tools : save_feedback_report()
        F_Tools : clone_task_for_rerun()
        F_Tools : trigger_auto_rerun()
    }
    
    state "end" as F_End <<end>>
    
    F_Start --> F_Agent
    F_Agent --> F_Tools : has_tool_calls
    F_Tools --> F_Agent : tool results
    F_Agent --> F_End : rerun_complete
}

' ===== CONNECTIONS BETWEEN GRAPHS =====
Pipeline --> Guardrails : run_stage7_guardrails(plan_id)
Guardrails --> Feedback : if validity_score < 75%
Feedback --> Pipeline : trigger_auto_rerun()\nwith new plan_id\n(TSK-xxx-R1)

' ===== RESUME/CHECKPOINT FLOW =====
note right of Pipeline
  **load_cached_state(task_id)**
  Checks output directories:
  - If summaries exist → skip stage1
  - If proposals exist → skip stage2
  - If plan exists → skip stage3
  - If prepared data → skip stage3b
  - If method proposal → skip stage3_5a
  - If tester output → skip stage3_5b
  - etc.
  
  Works for ANY task_id:
  TSK-005, TSK-005-R1, TSK-005-R2...
end note

note right of Feedback
  **Auto-Rerun Flow:**
  1. clone_task_for_rerun()
     TSK-005 → TSK-005-R1
  2. trigger_auto_rerun()
     - run_stage3_5a()
     - run_stage3_5b()
     - run_stage4()
     - run_stage7_guardrails()
  3. Report new score
end note

@enduml
